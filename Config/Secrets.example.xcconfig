// Copy to Secrets.xcconfig. The token is bundled so the app needs no setup on first launch.
TMDB_TOKEN = paste-your-tmdb-read-access-token
// SubDL key for the subtitle search (free at subdl.com/panel/api)
SUBDL_KEY = paste-your-subdl-key
// Optional: your CineFlix Sync server (see the cineflix-sync repository), so phones need no setup. The $() keeps "//" from starting a comment.
SYNC_SERVER = https:/$()/your-sync-server.example.workers.dev
// Optional: the sign-up code of your sync server, so a phone can create an account without typing it. Leave empty to ask instead.
SYNC_SIGNUP_CODE =
